  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/dev.ts",
    "build": "bun build ./src/index.tsx --outdir=dist --sourcemap --target=browser --minify --asset-naming='[name].[ext]' --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts"
  },
