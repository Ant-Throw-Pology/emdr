    "react-dom": "^19.2.3",
    "react-feather": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/howler": "^2.2.12",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-hid": "^1.0.7",
    "prettier": "^3.7.4"
  }
